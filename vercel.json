{
  "rewrites": [
    {
      "source": "/api/newsletter",
      "destination": "/api/newsletter/index.js"
    },
    {
      "source": "/api/health",
      "destination": "/api/newsletter/index.js"
    },
    {
      "source": "/api/phonepe/:path*",
      "destination": "/api/phonepe/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}